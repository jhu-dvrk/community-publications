{
    "research_fields": [
        {
            "id": "AU",
            "name": "Automation",
            "description": "This field refers to all the works automating any aspect of robotic surgery in order to improve the surgical workflow or to optimize the performance in a certain task."
        },
        {
            "id": "TR",
            "name": "Training, skill assessment and gesture recognition",
            "description": "Publications where new training platforms and protocols were designed and evaluated, as well as research efforts towards learning enhancement by multi-sensory training augmentation, skill assessment, and workflow analysis."
        },
        {
            "id": "HW",
            "name": "Hardware implementation and integration",
            "description": "All works that have contributed to develop the dVRK system, as well as further modifications of its software and hardware to make surgery more affordable and capable to interface with other surgical equipment."
        },
        {
            "id": "SS",
            "name": "System simulation and modelling",
            "description": "Studies that focused on the integration of the dVRK into simulation environments, optimizing simulation to obtain realistic robot interactions, and robot parametrization."
        },
        {
            "id": "IM",
            "name": "Imaging and vision",
            "description": "Publications related to the processing of images acquired by the endoscopic camera, including camera calibration, detection, segmentation, tracking, spatial mapping, and image augmentation."
        },
        {
            "id": "RE",
            "name": "Reviews",
            "description": "Review papers focused on the dVRK platform, its software/simulators, or dVRK-enabled research."
        }
    ],
    "data_types": [
        {
            "id": "RI",
            "name": "Raw Images",
            "description": "The left and right video stream from the da Vinci stereo endoscope or any other cameras"
        },
        {
            "id": "KD",
            "name": "Kinematic Data",
            "description": "Information associated to the kinematics of the dVRK (including ECM, MTMs, PSMs and SUJ)"
        },
        {
            "id": "DD",
            "name": "Dynamic Data",
            "description": "Information associated to the dynamics of the dVRK (including ECM, MTMs, PSMs)"
        },
        {
            "id": "SD",
            "name": "System Data",
            "description": "Data associated to the robot teleoperation states, as signals coming from foot pedals, head sensor for operator presence detection, etc."
        },
        {
            "id": "ED",
            "name": "External Data",
            "description": "All data associated with additional technologies that were used along with the dVRK, such as eye trackers, force sensors, different imaging technologies, etc."
        }
    ],
    "peer_reviewed": [
        {
            "id": "yes",
            "name": "Peer-Reviewed",
            "description": "Formally peer-reviewed journal, conference, or symposium publication."
        },
        {
            "id": "no",
            "name": "Preprint / Unreviewed",
            "description": "Preprint (arXiv, Research Square, SSRN) or technical report not yet peer-reviewed."
        },
        {
            "id": "thesis",
            "name": "Thesis / Dissertation",
            "description": "Ph.D. dissertation or Master's thesis defended before an academic committee."
        }
    ],
